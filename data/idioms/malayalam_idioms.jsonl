{"id": "ml1", "idiom": "അകത്തു കടത്തുക", "meaning": "ഭക്ഷിക്കുക"}
{"id": "ml2", "idiom": "അകത്തു കത്തിയും പുറത്തു പത്തിയും", "meaning": "ഉള്ളില്‍ വിരോധം നടിച്ചു കൊണ്ട് പുറമെ സ്നേഹം ഭാവിക്കുക"}
{"id": "ml3", "idiom": "അകത്തമ്മ ചമയുക", "meaning": "വലിയ മേന്മ നടിക്കുക"}
{"id": "ml4", "idiom": "അകമ്പടി കൂടുക", "meaning": "ബഹുമാനപൂർവ്വം മുന്നിൽ നിൽക്കുക"}
{"id": "ml5", "idiom": "അകലേ ഉഴുത് പകലേ പോരുക", "meaning": "ജോലിയിൽ കളളത്തരം കാണിക്കുക"}
{"id": "ml6", "idiom": "അകം തുറക്കുക", "meaning": "മനസ്സു തുറക്കുക"}
{"id": "ml7", "idiom": "അക്കരപ്പച്ച", "meaning": "അകലെയുള്ളതിനോടുള്ള ഭ്രമം"}
{"id": "ml8", "idiom": "അക്കരപ്പറ്റുക", "meaning": "വിഷമഘട്ടം തരണം ചെയ്യുക"}
{"id": "ml9", "idiom": "അച്ചിലിട്ട് വാർക്കുക", "meaning": "ഒരേ രൂപത്തിലാക്കുക"}
{"id": "ml10", "idiom": "അജഗരന്യായം", "meaning": "ഒന്നിനും വേണ്ടി പരിശ്രമിക്കാതെ കിട്ടുന്നത് കൊണ്ട് തൃപ്തിപ്പെടുക"}
{"id": "ml11", "idiom": "അജഗജാന്തരം", "meaning": "വലിയ വ്യത്യാസം"}
{"id": "ml12", "idiom": "അജഗളസ്ഥാനം", "meaning": "അസ്ഥാനത്ത് ആയതിനാൽ ആവശ്യമായത്"}
{"id": "ml13", "idiom": "അടക്കമില്ലാത്ത തത്ത അടുപ്പിൽ പോകും", "meaning": "അടങ്ങിയിരുന്നില്ലെങ്കിൽ ആപത്തുണ്ടാകും"}
{"id": "ml14", "idiom": "അടിച്ചൂലു തലയ്ക്കു വയ്ക്കുക", "meaning": "യോഗ്യതയില്ലാത്തതിന് ഉന്നതസ്ഥാനം നൽകുക"}
{"id": "ml15", "idiom": "അടിയറ പറയിക്കുക", "meaning": "പരാജയം സമ്മതിപ്പിക്കുക"}
{"id": "ml16", "idiom": "അടിക്കഞ്ഞികുടിക്കുക", "meaning": "ഉപജീവനം കഴിക്കുക"}
{"id": "ml17", "idiom": "അടിക്കല്ല് മാന്തുക", "meaning": "ഉന്മൂലനാശം വരുത്തുക"}
{"id": "ml18", "idiom": "അടിക്കലം വലിക്കുക", "meaning": "ദോഷം വരുത്തുക"}
{"id": "ml19", "idiom": "അടി തെറ്റുക", "meaning": "സ്ഥാനം പിഴയ്ക്കുക"}
{"id": "ml20", "idiom": "അടി തൊട്ടു മുടിവരെ", "meaning": "മുഴുവന്‍‌"}
{"id": "ml21", "idiom": "അടി പണിയുക", "meaning": "സേവ പിടിക്കുക"}
{"id": "ml22", "idiom": "അടിയോടെ", "meaning": "മുഴുവന്‍"}
{"id": "ml23", "idiom": "അടുക്കളക്കാര്യം", "meaning": "വീട്ടുകാര്യം"}
{"id": "ml24", "idiom": "അടുക്കള കലഹം", "meaning": "സ്ത്രീകൾ തമ്മിലുള്ള വഴക്ക്"}
{"id": "ml25", "idiom": "അടുക്കള കുറ്റം", "meaning": "ചാരിത്യഭംഗം"}
{"id": "ml26", "idiom": "അടുക്കള മിടുക്ക്", "meaning": "സ്ത്രീകളുടെ സാമർത്ഥ്യം"}
{"id": "ml27", "idiom": "അഞ്ചാം പത്തി", "meaning": "ഒറ്റുകൊടുക്കാന്‍ സഹായിക്കുന്നവന്‍"}
{"id": "ml28", "idiom": "അഞ്ചാം തരക്കാര്‍", "meaning": "അദ്ധമന്മാര്‍"}
{"id": "ml29", "idiom": "അത്തിപ്പഴത്തോളം", "meaning": "അല്പം"}
{"id": "ml30", "idiom": "അധരവ്യായാമം", "meaning": "അര്‍തഥ്ശൂന്യ സംസാരം"}
{"id": "ml31", "idiom": "അധരാനുകമ്പ", "meaning": "വാക്കില്‍ മാത്രമുള്ള ആനുകൂല്യം"}
{"id": "ml32", "idiom": "അനന്തൻകാട്", "meaning": "ഭയമുണ്ടാക്കുന്ന സ്ഥലം"}
{"id": "ml33", "idiom": "അങ്ങാടി മരുന്നോ പച്ച മരുന്നോ", "meaning": "അറിവില്ലായ്മ"}
{"id": "ml34", "idiom": "അന്യം നിൽക്കുക", "meaning": "അവകാശി ഇല്ലാതാകുക"}
{"id": "ml35", "idiom": "അമ്പലം വിഴുങ്ങുക", "meaning": "മുഴുവനും കൊള്ള ചെയ്യുക"}
{"id": "ml36", "idiom": "അബദ്ധപഞ്ചാംഗം", "meaning": "പരമാബദ്ധം"}
{"id": "ml37", "idiom": "അമരക്കാരന്‍", "meaning": "മാര്‍ഗ്ഗ ദര്‍ഷകന്‍"}
{"id": "ml38", "idiom": "അമരം തെറ്റുക", "meaning": "അപകടത്തിലാവുക"}
{"id": "ml39", "idiom": "അമരം പിടിക്കുക", "meaning": "വഴികാട്ടുക"}
{"id": "ml40", "idiom": "അരക്കൈനോക്കുക", "meaning": "പരീക്ഷിക്കുക"}
{"id": "ml41", "idiom": "അരങ്ങേറ്റം", "meaning": "ആദ്യപ്രകടനം"}
{"id": "ml42", "idiom": "അരയും തലയും മുറുക്കുക", "meaning": "തയ്യാറാവുക"}
{"id": "ml43", "idiom": "അരക്കച്ച മുറിക്കുക", "meaning": "തയ്യാറാവുക"}
{"id": "ml44", "idiom": "അര വൈദ്യൻ ആളെ കൊല്ലി", "meaning": "അല്പജ്ഞാനം ആപത്ത്"}
{"id": "ml45", "idiom": "അരയന്ന നട അഭിനയിക്കുക", "meaning": "ഇല്ലാത്തതുണ്ടെന്നു ഭാവിക്കുക"}
{"id": "ml46", "idiom": "അരി എണ്ണുക", "meaning": "നിഷ്ഫലമായ പ്രവർത്തി ചെയ്യുക"}
{"id": "ml47", "idiom": "അരിയെത്തുക", "meaning": "മരിക്കുക"}
{"id": "ml48", "idiom": "അറുപതാം കാലം", "meaning": "വാർദ്ധക്യം"}
{"id": "ml49", "idiom": "അറുത്തകൈയ്ക്ക് ഉപ്പ് തേക്കാത്തവൻ", "meaning": "നിര്‍ദ്ദയൻ"}
{"id": "ml50", "idiom": "അറുതി വരുത്തുക", "meaning": "നശിപ്പിക്കുക"}
{"id": "ml51", "idiom": "അർദ്ധരാത്രിയിൽ കുട പിടിക്കുക", "meaning": "അസ്ഥനത്തുള്ള ആഡംബരം"}
{"id": "ml52", "idiom": "അലകും പിടിയും മാറ്റുക", "meaning": "മുഴുവന്‍ പുതുക്കുക"}
{"id": "ml53", "idiom": "അളമുട്ടുക", "meaning": "ഗ്തിയില്‍ലാതാവുക"}
{"id": "ml54", "idiom": "അസുരവിത്ത്", "meaning": "ദുഷ്ടരായ മക്കൾ"}
{"id": "ml55", "idiom": "അഷ്ടമത്തില്‍ ശനി", "meaning": "കഷ്ടകാലം"}
{"id": "ml56", "idiom": "അസ്തിവാരം", "meaning": "അടിസ്ഥാനം"}
{"id": "ml57", "idiom": "അഴകിയ രാവണൻ", "meaning": "കെട്ടിയൊരുങ്ങിയ ജളൻ"}
{"id": "ml58", "idiom": "അഴകുള്ള ചക്കയ്ക്ക് ചുളയില്ല", "meaning": "പുറമേ കാണുന്നതില്ല കാര്യം"}
{"id": "ml59", "idiom": "അഗ്നിപരീക്ഷ", "meaning": "കഠിനമായ പരിക്ഷണം"}
{"id": "ml60", "idiom": "അംഗുലീ പരിമിതം", "meaning": "പരിമിത വസ്തു"}
{"id": "ml61", "idiom": "അട്ടിപ്പേറ്", "meaning": "സ്വന്തവും ശാശ്വതവുമായത്"}
{"id": "ml62", "idiom": "ആകാശകുസുമം", "meaning": "സംഭവിക്കാത്ത കാര്യം"}
{"id": "ml63", "idiom": "ആകാശം നോക്കുക", "meaning": "ഉത്തരം മുട്ടുക"}
{"id": "ml64", "idiom": "ആകാശ കോട്ട കെട്ടുക", "meaning": "മനോരാജ്യം കാണുക"}
{"id": "ml65", "idiom": "ആകാശ പുരാണം", "meaning": "അസത്യമായ കാര്യം"}
{"id": "ml66", "idiom": "ആകാശ പന്തൽ ഇടുക", "meaning": "അടിസ്ഥാനമില്ലാതെ നിർമ്മിക്കുക"}
{"id": "ml67", "idiom": "ആക്യതിയും പ്രക്യതിയും", "meaning": "രൂപവും ഭാവവും"}
{"id": "ml68", "idiom": "ആചന്ദ്രതാരം", "meaning": "ചന്ദ്രനും താരങ്ങളുമുള്ള കാലത്തോളം"}
{"id": "ml69", "idiom": "ആദ്യവസാനക്കാരന്‍", "meaning": "പ്രധാന പങ്കാളി"}
{"id": "ml70", "idiom": "ആനച്ചന്തം", "meaning": "ആകപ്പാടെയുള്ള ഭംഗി"}
{"id": "ml71", "idiom": "ആപാദചൂഡം", "meaning": "ആകെ"}
{"id": "ml72", "idiom": "അടതാളമട്ട", "meaning": "സാവധാനം"}
{"id": "ml73", "idiom": "ആടു മേഞ്ഞ കാട്", "meaning": "ശൂന്യമായ സ്ഥലം"}
{"id": "ml74", "idiom": "ആട്ടിന്‍‌കുട്ടി ചമയുക", "meaning": "സൗമ്യത നടിക്കുക"}
{"id": "ml75", "idiom": "ആലത്തൂർ കാക്ക", "meaning": "ആശിച്ചു കാലം കഴിക്കുന്നവർ"}
{"id": "ml76", "idiom": "ആറാട്ടു കൊമ്പൻ", "meaning": "വലിയ പ്രധാന"}
{"id": "ml77", "idiom": "ആയുധം വയ്ക്കുക", "meaning": "കിഴ് അടങ്ങുക"}
{"id": "ml78", "idiom": "ആഷാഢഭൂതി", "meaning": "കള്ളസന്യാസി"}
{"id": "ml79", "idiom": "ഇരുതല മൂരി", "meaning": "രണ്ടു പക്ഷത്തും ചേരുന്നവന്‍"}
{"id": "ml80", "idiom": "ഇലയിട്ടു ചവിട്ടുക", "meaning": "അറിഞ്ഞുകൊണ്ടപരാദം പ്രവര്‍ത്തിക്കുക"}
{"id": "ml81", "idiom": "ഇലവു കാത്ത കിളി", "meaning": "ഫലമില്ലാതെ കാത്തിരിക്കുന്നവൻ"}
{"id": "ml82", "idiom": "ഇല്ലത്തെ പൂച്ച", "meaning": "എവിടെയും പ്രവേശനം ഉള്ള ആൾ"}
{"id": "ml83", "idiom": "ഇഞ്ചി കടിക്കുക", "meaning": "അകാരണമായി ദേഷ്യപ്പെടുക"}
{"id": "ml84", "idiom": "ഇരയിട്ട മിന്‍ പിടിക്കുക", "meaning": "അല്പം ചിലവാക്കി വലിയ ലാഭം ഉണ്ടാക്കുക"}
{"id": "ml85", "idiom": "ഇരുതലയും കുട്ടിമുട്ടിക്കുക", "meaning": "വരവും ചെലവും സമമാക്കുക"}
{"id": "ml86", "idiom": "ഇരുട്ടടി", "meaning": "രഹസ്യമായി നേരിടുന്ന അപകടം"}
{"id": "ml87", "idiom": "ഇരുട്ടു കൊണ്ടോട്ടയടയ്ക്കുക", "meaning": "തൽക്കാലപരിഹാരം കാണുക"}
{"id": "ml88", "idiom": "ഇടംകോലിടുക", "meaning": "തടസ്സമുണ്ടാക്കുക"}
{"id": "ml89", "idiom": "ഇടിവെട്ടിയവനെ പാമ്പുകടിക്കുക", "meaning": "ആപത്തിന്‍ മേല്‍ ആപത്ത്"}
{"id": "ml90", "idiom": "ഇത്തിൾക്കണ്ണി", "meaning": "മറ്റുള്ളവരെ ഉപയോഗിച്ച് കാര്യം നേടുന്നവർ"}
{"id": "ml91", "idiom": "ഉണ്ട ചോറിൽ കല്ലിടുക", "meaning": "നന്ദികേട് കാണിക്കുക"}
{"id": "ml92", "idiom": "ഉലക്ക മേൽ കിടക്കുക", "meaning": "അസാധ്യമായ കാര്യം ചെയ്യുക"}
{"id": "ml93", "idiom": "ഉർവ്വശി ചമയുക", "meaning": "അതീവസുന്ദരിയെന്ന് ഭാവിക്കുക"}
{"id": "ml94", "idiom": "ഉറിയിൽ കയറ്റുക", "meaning": "പറ്റിച്ച് അബദ്ധത്തിൽ ചാടിക്കുക"}
{"id": "ml95", "idiom": "ഉദരപുരണം", "meaning": "ഉപജീവനം"}
{"id": "ml96", "idiom": "ഉപ്പുതൊട്ടു കർപ്പൂരംവരെ", "meaning": "സകലതും"}
{"id": "ml97", "idiom": "ഉപ്പു കൂട്ടി തിന്നുക", "meaning": "നന്ദികാണിക്കുക"}
{"id": "ml98", "idiom": "ഉപ്പും ചോറും തിന്നുക", "meaning": "ആശ്രിതനായി കഴിയുക"}
{"id": "ml99", "idiom": "ഉപ്പില്ലാത്ത കഞ്ഞി", "meaning": "അത്യാവശ്യം വേണ്ടുന്നത് ഇല്ലാതിരിക്കൽ"}
{"id": "ml100", "idiom": "ഉള്ളംകാൽ വെളുക്കുക", "meaning": "വളരെ അധികം ദൂരം നടക്കുക"}
{"id": "ml101", "idiom": "ഉണ്ണാൻ പടയുണ്ട് വെട്ടാൻ പാടില്ല", "meaning": "അനുഭവിക്കാനാളുണ്ട്, വേല ചെയ്യാനാരുമില്ല"}
{"id": "ml102", "idiom": "ഉടലും നിഴലുപോലെ", "meaning": "വേർപിരിയാതെ"}
{"id": "ml103", "idiom": "ഉടച്ചുവാര്‍ക്കുക", "meaning": "പുതുക്കുക"}
{"id": "ml104", "idiom": "ഉടുത്തൊരുങ്ങുക", "meaning": "തയ്യാറാവുക"}
{"id": "ml105", "idiom": "ഉട്ടോപ്യ", "meaning": "പ്രയോഗികമല്ലാത്തത്"}
{"id": "ml106", "idiom": "ഉരുളയ്ക്കുപ്പേരി", "meaning": "ഉചിതമായ മറുപടി"}
{"id": "ml107", "idiom": "ഉരൽ മദ്ദളത്തോടു സങ്കടം പറയുക", "meaning": "ചെറിയ സങ്കടക്കാരൻ വലിയ സങ്കടക്കാരനോടു പരാതി പറയുക"}
{"id": "ml108", "idiom": "ഉയിരും ഉടലും പോലെ", "meaning": "ഒരിക്കലും പിരിയാത്ത"}
{"id": "ml109", "idiom": "ഉമ്മാക്കി കാട്ടുക", "meaning": "ഭയപ്പെടുത്തുക"}
{"id": "ml110", "idiom": "ഉഴലുര്‍ദേവസ്വം", "meaning": "അലഞ്ഞുതിരിഞ്ഞു നടക്കുന്നവന്‍"}
{"id": "ml111", "idiom": "ഊറ്റം പറയുക", "meaning": "ആത്മപ്രശംസ ചെയ്യുക"}
{"id": "ml112", "idiom": "ഊഴിയം നടത്തുക", "meaning": "ആത്മാർത്ഥതയില്ലാതെ പ്രവർത്തിക്കുക"}
{"id": "ml113", "idiom": "ഊണിലും ഉറക്കത്തിലും", "meaning": "എല്ലായ്പോഴും"}
{"id": "ml114", "idiom": "ഊരും പേരുമില്ലാത്ത", "meaning": "അപ്രസിദ്ധമായ"}
{"id": "ml115", "idiom": "ഊറ്റിക്കുടിക്കുക", "meaning": "അപഹരിക്കുക"}
{"id": "ml116", "idiom": "എന്‍പിള്ള നയം", "meaning": "സ്വാര്‍ത്ഥത"}
{"id": "ml117", "idiom": "എള്ളു കീറുക", "meaning": "കർശനമായി പെരുമാറുക"}
{"id": "ml118", "idiom": "എള്ളിൽ വീണ ഒച്ച്", "meaning": "അനങ്ങാൻ വയ്യാത്ത അവസ്ഥ"}
{"id": "ml119", "idiom": "എള്ളോളം", "meaning": "അൽപം"}
{"id": "ml120", "idiom": "എട്ടാം പൊരുത്തം", "meaning": "യോജിപ്പില്ലായ്മ"}
{"id": "ml121", "idiom": "എണ്ണിക്കഴിക്ക", "meaning": "ഉത്കണ്ഠാപൂർവ്വം കാത്തിരിക്കുക"}
{"id": "ml122", "idiom": "എണ്ണിച്ചുട്ട അപ്പം", "meaning": "പരിമിത വസ്തു"}
{"id": "ml123", "idiom": "എരി കേറ്റുക", "meaning": "വൈരാഗ്യം വർധിപ്പിക്കുക"}
{"id": "ml124", "idiom": "എരിതീയിൽ എണ്ണയൊഴിക്കുക", "meaning": "ക്ലേശം വര്‍ധിപ്പിക്കുക"}
{"id": "ml125", "idiom": "എറെ വെള്ളം എറുമ്പിനു സമുദ്രം", "meaning": "അല്പവസ്തുക്കളും നിസ്സാരന്മാർക്കു വലുതായി തോന്നും"}
{"id": "ml126", "idiom": "എലിയെത്തോൽപ്പിച്ചു ഇല്ലം ചുടുക", "meaning": "നിസ്സാരകാര്യത്തിനു വലിയ നഷ്ടം വരുത്തുക"}
{"id": "ml127", "idiom": "എട്ടുകാലി മമ്മൂഞ്ഞ്", "meaning": "എന്തിന്റെയും ഉത്തരവാദിത്വം ഏറ്റെടുക്കുക"}
{"id": "ml128", "idiom": "ഏഴാംകൂലി", "meaning": "അംഗീകാരമില്ലാത്തവൻ"}
{"id": "ml129", "idiom": "ഏഴരശശനി", "meaning": "വലിയ ദുഷ്ക്കാലം"}
{"id": "ml130", "idiom": "ഏട്ടിലെ പശു", "meaning": "പ്രയോഗസാധ്യമല്ലാത്ത വിജ്ഞാനം"}
{"id": "ml131", "idiom": "ഏറിയകൂറും", "meaning": "ഭൂരിഭാഗവും"}
{"id": "ml132", "idiom": "ഏറാൻ മൂളുക", "meaning": "എല്ലാം സമ്മതിക്കുക"}
{"id": "ml133", "idiom": "ഏറ്റുപാടുക", "meaning": "ശിങ്കിടിപാടുക"}
{"id": "ml134", "idiom": "ഏടാകൂടം", "meaning": "അപകടം, ദുർഘടം"}
{"id": "ml135", "idiom": "ഏടുകെട്ടുക", "meaning": "പഠിത്തം അവസാനിപ്പിക്കുക"}
{"id": "ml136", "idiom": "ഏണി വയ്ക്കുക", "meaning": "സഹായിക്കുക"}
{"id": "ml137", "idiom": "ഏഷണി കൂട്ടുക", "meaning": "ഇല്ലാത്തത് പറഞ്ഞു തമ്മിൽ തല്ലിക്കുക"}
{"id": "ml138", "idiom": "ഏകാദശി നോക്കുക", "meaning": "പട്ടിണി കിടക്കുക"}
{"id": "ml139", "idiom": "ഏകോദര സഹോദരൻമാർ", "meaning": "പരസ്പരം സ്നേഹവിശ്വാസം കാത്തു സൂക്ഷിക്കുന്നവർ"}
{"id": "ml140", "idiom": "ഒത്താശ", "meaning": "സഹായം"}
{"id": "ml141", "idiom": "ഒച്ചപ്പാട്", "meaning": "വലിയ ശബ്ദം"}
{"id": "ml142", "idiom": "ഒളിയമ്പ്", "meaning": "രഹസ്യോപദ്രവം"}
{"id": "ml143", "idiom": "ഓലപ്പാമ്പ്", "meaning": "വ്യർത്ഥമായ ഭീഷണി"}
{"id": "ml144", "idiom": "ഒഴിയാബാധ", "meaning": "മാറാത്ത ഉപദ്രവം"}
{"id": "ml145", "idiom": "ഒന്നിനൊന്ന്", "meaning": "മേലക്കുമേല്‍"}
{"id": "ml146", "idiom": "ഒറ്റുകൊടുക്കുക", "meaning": "ചതിക്കുക"}
{"id": "ml147", "idiom": "ഒറ്റയ്ക്കും തെറ്റയ്ക്കും", "meaning": "അങ്ങിങ്ങായി"}
{"id": "ml148", "idiom": "ഒമ്പതാമുത്സവം", "meaning": "വലിയ ബഹളം"}
{"id": "ml149", "idiom": "ഒരു കൈ നോക്കുക", "meaning": "പരീക്ഷിക്കുക"}
{"id": "ml150", "idiom": "ഒരു വെടിക്കു രണ്ടു പക്ഷി", "meaning": "ഒരു പ്രവ്യത്തി കൊണ്ടു രണ്ടു കാര്യം നേടുക"}
{"id": "ml151", "idiom": "ഒഴുക്കിനെതിരെ നീന്തുക", "meaning": "പ്രതിസന്ധികളെ നേരിടുക"}
{"id": "ml152", "idiom": "ഓങ്ങി വയ്ക്കുക", "meaning": "ചെയ്യാൻ ഭാവിക്കുക"}
{"id": "ml153", "idiom": "ഓതിരം മറിയുക", "meaning": "അഭ്യാസം കാട്ടുക"}
{"id": "ml154", "idiom": "ഓട്ടപ്രദക്ഷിണം നടത്തുക", "meaning": "തിടുക്കത്തിൽ കൃത്യം നിർവഹിക്കുക"}
{"id": "ml155", "idiom": "ഓണംകേറാമല", "meaning": "പരിഷ്കാരമില്ലാത്ത സ്ഥലം"}
{"id": "ml156", "idiom": "ഓളം നിന്നിട്ട് കടലാടുക", "meaning": "അസാദ്ധ്യമായ കാര്യം"}
{"id": "ml157", "idiom": "കച്ച കെട്ടുക", "meaning": "തയ്യാറാവുക"}
{"id": "ml158", "idiom": "കടന്നകൈ", "meaning": "അതിരു കവിഞ്ഞ രീതി"}
{"id": "ml159", "idiom": "കടശ്ശിക്കൈ", "meaning": "അവസാനകര്‍മ്മം"}
{"id": "ml160", "idiom": "കടലാസുപുലി", "meaning": "വ്യർത്ഥമായ ഭീഷണി"}
{"id": "ml161", "idiom": "കടലില്‍ കായം കലക്കുക", "meaning": "അധികം വേണ്ടിടത്ത് അല്പം നല്കുക"}
{"id": "ml162", "idiom": "കടവടുപ്പിക്കുക", "meaning": "ഒരു സ്ഥാനത്തെത്തിക്കുക"}
{"id": "ml163", "idiom": "കടുകിട", "meaning": "അല്പംപോലും"}
{"id": "ml164", "idiom": "കടുവാക്കുട്ടില്‍ തലയിടുക", "meaning": "സ്വയം അപകടത്തില്‍ ചാടുക"}
{"id": "ml165", "idiom": "കടുവായെ കിടുവ പിടിക്കുക", "meaning": "ബലവാനെ ദുര്‍ബലന്‍ തോൽപ്പിക്കുക"}
{"id": "ml166", "idiom": "കടുംകൈ", "meaning": "കഠിന പ്രവ്യത്തി"}
{"id": "ml167", "idiom": "കണക്കുതീര്‍ക്കുക", "meaning": "കൊല്ലുക"}
{"id": "ml168", "idiom": "കണ്ഠക്ഷോഭം", "meaning": "നിഷ്ഫലമായ സംസാരം"}
{"id": "ml169", "idiom": "കണിയാനെ തെങ്ങില്‍ കയറ്റുക", "meaning": "പരിചയമില്ലാത്ത പ്രവ്യത്തി ഏല്‍പ്പിക്കുക"}
{"id": "ml170", "idiom": "കണ്ടകശശനി", "meaning": "ഉപദ്രവകാരി"}
{"id": "ml171", "idiom": "കണ്ണടച്ചിരുട്ടാക്കുക", "meaning": "സത്യവിരുദ്ധമായ പ്രവർത്തിക്കുക"}
{"id": "ml172", "idiom": "കണ്ണടയ്ക്കുക", "meaning": "കണ്ടില്ലെന്ന് നടിക്കുക"}
{"id": "ml173", "idiom": "കണ്ണയക്കുക", "meaning": "ദയ കാണിക്കുക"}
{"id": "ml174", "idiom": "കണ്ണുകടി", "meaning": "അസൂയ"}
{"id": "ml175", "idiom": "കണ്ണിലുണ്ണി", "meaning": "വാത്സല്യപാത്രം"}
{"id": "ml176", "idiom": "കണ്ണില്‍ചോരയില്ലായ്മ", "meaning": "കനിവ് ഇല്ലായ്മ"}
{"id": "ml177", "idiom": "കണ്ണിടുക", "meaning": "ദൃഷ്ടിദോഷം"}
{"id": "ml178", "idiom": "കണ്ണിൽ കുത്തുക", "meaning": "ദ്രോഹിക്കുക"}
{"id": "ml179", "idiom": "കണ്ണിൽ മണ്ണിടുക", "meaning": "വഞ്ചിക്കുക"}
{"id": "ml180", "idiom": "കണ്ണിൽ പൊടിയിടുക", "meaning": "ചതിക്കുക"}
{"id": "ml181", "idiom": "കണ്ണിലെ കരട്", "meaning": "സദാ ഉപദ്രവകാരി"}
{"id": "ml182", "idiom": "കണ്‍കുളിരെ", "meaning": "ത്യപ്തിയാവോളം"}
{"id": "ml183", "idiom": "കതിരിന്മേൽ വളം വയ്ക്കുക", "meaning": "കാലംതെറ്റി പ്രവർത്തിക്കുക"}
{"id": "ml184", "idiom": "കന്നിനെ കയം കാണിക്കുക", "meaning": "ആകർഷകമായ വസ്തുവിൽ മതിമറക്കുക"}
{"id": "ml185", "idiom": "കമ്പിനീട്ടുക", "meaning": "ഓടികളയുക"}
{"id": "ml186", "idiom": "കര പിടിക്കുക", "meaning": "രക്ഷ പ്രാപിക്കുക"}
{"id": "ml187", "idiom": "കരണം മറിയുക", "meaning": "ഒഴിഞ്ഞുമാറുക"}
{"id": "ml188", "idiom": "കരണി പ്രസവം", "meaning": "അപൂർവമായ സംഭവം"}
{"id": "ml189", "idiom": "കരതലാമലകം", "meaning": "ഉള്ളം കയ്യിലെ നെല്ലിക്ക പോലെ സ്പഷ്ടം"}
{"id": "ml190", "idiom": "കലക്കി കുടിക്കുക", "meaning": "മുഴുവനും ഗ്രഹിക്കുക"}
{"id": "ml191", "idiom": "കലാശം ചവിട്ടുക", "meaning": "മംഗളം പാടുക"}
{"id": "ml192", "idiom": "കായംകുളം വാൾ", "meaning": "ദാക്ഷണ്യമില്ലാത്ത ശിക്ഷ"}
{"id": "ml193", "idiom": "കാകദന്തഗവേഷണം", "meaning": "നിഷ്ഫലയത്നം"}
{"id": "ml194", "idiom": "കാക്ക പിടിക്കുക", "meaning": "സേവ പറയുക"}
{"id": "ml195", "idiom": "കാപ്പുകെട്ടുക", "meaning": "ഒരുങ്ങുക"}
{"id": "ml196", "idiom": "കാടും പടലും തല്ലുക", "meaning": "അപ്രസക്തമായത് പ്രതിപാദിക്കുക"}
{"id": "ml197", "idiom": "കാനന ചന്ദ്രിക", "meaning": "ഉപയോഗശൂന്യമായത്"}
{"id": "ml198", "idiom": "കാനൽജലം", "meaning": "തോന്നൽ മാത്രം"}
{"id": "ml199", "idiom": "കാലു പിടിക്കുക", "meaning": "അഭിമാനം മറന്ന് യാചിക്കുക"}
{"id": "ml200", "idiom": "കാലുവാരുക", "meaning": "ചതിക്കുക"}
{"id": "ml201", "idiom": "കിണറ്റിലെ തവള", "meaning": "ലോകപരിജ്ഞാനം കുറഞ്ഞ ആൾ"}
{"id": "ml202", "idiom": "കീചകന്‍", "meaning": "തികഞ്ഞ വിടന്‍"}
{"id": "ml203", "idiom": "കീരിയും പാമ്പും", "meaning": "ജന്മ ശത്രുക്കൾ"}
{"id": "ml204", "idiom": "കീറാമുട്ടി", "meaning": "മനസ്സിലാക്കാൻ ബുദ്ധിമുട്ട്"}
{"id": "ml205", "idiom": "കുംഭകര്‍ണ്ണസേവ", "meaning": "വലിയ ഉറക്കം"}
{"id": "ml206", "idiom": "കുംഭകോണം", "meaning": "അഴിമതി"}
{"id": "ml207", "idiom": "കുടത്തിലെ വിളക്ക്", "meaning": "അറിയപ്പെടാത്ത പ്രതിഭ"}
{"id": "ml208", "idiom": "കുതിര കയറുക", "meaning": "കാരണമില്ലാതെ ഉപദ്രവിക്കുക"}
{"id": "ml209", "idiom": "കുബേരനും കുചേലനും", "meaning": "ധനികനും ദരിദ്രനും"}
{"id": "ml210", "idiom": "കുറുക്കനും സിംഹവും", "meaning": "കൌശലക്കാരനും ,പരാക്രമിയും"}
{"id": "ml211", "idiom": "കുറുപ്പിന്റെ ഉറപ്പ്", "meaning": "നിഷ്ഫലമായ ഉറപ്പ്"}
{"id": "ml212", "idiom": "കുളിക്കാതെ ഈറൻ ചുമക്കുക", "meaning": "കുറ്റം ചെയ്യാതെ ആരോപണവിധേയൻ ആകുക"}
{"id": "ml213", "idiom": "കുളം കോരുക", "meaning": "ഉന്മൂലനാശമുണ്ടാക്കുക"}
{"id": "ml214", "idiom": "കുളിച്ച കടവ് മറക്കരുത്", "meaning": "കഴിഞ്ഞ അനുഭവങ്ങളും പ്രവർത്തികളും മറക്കരുത്"}
{"id": "ml215", "idiom": "കുഴിയിലേക്ക് കാൽ നീട്ടുക", "meaning": "പ്രായമായി മരിക്കുക"}
{"id": "ml216", "idiom": "കുട്ടിച്ചോറാക്കുക", "meaning": "നശിപ്പിക്കുക"}
{"id": "ml217", "idiom": "കുന്തം വിഴുങ്ങുക", "meaning": "അബദ്ധം പിണയുക"}
{"id": "ml218", "idiom": "കൂടോത്രം", "meaning": "മന്ത്രവാദം"}
{"id": "ml219", "idiom": "കൂടെയിരുന്നു കഴുത്തറക്കുക", "meaning": "അടുത്തു കൂടി ചതിക്കുക"}
{"id": "ml220", "idiom": "കൂനിന്മേൽ കുരു പോലെ", "meaning": "ആപത്തിന്മേൽ ആപത്ത്"}
{"id": "ml221", "idiom": "കൈമെയ് മറക്കുക", "meaning": "നിയന്ത്രണം വിടുക"}
{"id": "ml222", "idiom": "കൈയാടിയെങ്കിലേ വായാടൂ", "meaning": "പ്രവർത്തി ചെയ്തങ്കിലേ ഉപജീവനത്തിന് വഴിയുണ്ടാകൂ"}
{"id": "ml223", "idiom": "കയ്യാലപ്പുറത്തെ തേങ്ങ", "meaning": "ഏതു കക്ഷിയില്‍ ചേരണമെന്ന അറിയാത്താള്‍"}
{"id": "ml224", "idiom": "കേമദ്രുമയോഗം", "meaning": "വലിയ കഷ്ടകാലം"}
{"id": "ml225", "idiom": "കേളികൊട്ടുക", "meaning": "പരസ്യപ്പെടുത്തുക"}
{"id": "ml226", "idiom": "കൊടുംപിരി കൊള്ളുക", "meaning": "ശക്തിമത്താകുക"}
{"id": "ml227", "idiom": "കൊള്ളിയുന്തുക", "meaning": "അടുക്കളപ്പണി ചെയ്യുക"}
{"id": "ml228", "idiom": "കൊല്ലക്കുടിയിൽ സൂചി വിൽക്കുക", "meaning": "ഒരു വസ്തു സുലഭമായി കിട്ടുന്നിടത്തു അത് വിൽക്കുവാൻ നോക്കുന്നത്"}
{"id": "ml229", "idiom": "കോമരം തുള്ളുക", "meaning": "പരപ്രേരണ കൊണ്ട് എന്തും പ്രവർത്തിക്കുക"}
{"id": "ml230", "idiom": "കോയിത്തമ്പുരാൻ", "meaning": "ഭാര്യയുടെ വരുതിയിൽ നിൽക്കുന്ന ഭർത്താവ്"}
{"id": "ml231", "idiom": "കോവിൽക്കാള", "meaning": "മറ്റു പണിയൊന്നും ചെയ്യാതെ അലസരായി നടക്കുക"}
{"id": "ml232", "idiom": "ഗതാനുഗതികത്വം", "meaning": "അനുകരണശീലം"}
{"id": "ml233", "idiom": "ഗതാനുഗതികന്യായം", "meaning": "അനുകരണശീലം"}
{"id": "ml234", "idiom": "ഗണപതിക്കല്യാണം", "meaning": "നടക്കാത്ത കാര്യം"}
{"id": "ml235", "idiom": "ഗണപതിക്കു കുറിക്കുക", "meaning": "ആരംഭം കുറിക്കുക"}
{"id": "ml236", "idiom": "ഗജനിമീലനം", "meaning": "കണ്ടാലും കണ്ടില്ലെന്ന നാട്യം"}
{"id": "ml237", "idiom": "ഗോപി തൊടുക", "meaning": "വിഫലമാകുക"}
{"id": "ml238", "idiom": "ചക്രം ചവിട്ടുക", "meaning": "കഠിനമായി ബുദ്ധിമുട്ടുക"}
{"id": "ml239", "idiom": "ചക്രശ്വാസം വലിക്കുക", "meaning": "അത്യധികം വിഷമിക്കുക"}
{"id": "ml240", "idiom": "ചക്കിനു വച്ചത് കൊക്കിന് കൊള്ളുക", "meaning": "ഉദ്ദേശിച്ച കാര്യത്തിന് പകരം മറ്റൊന്ന് നടക്കുക"}
{"id": "ml241", "idiom": "ചരടുപിടിക്കുക", "meaning": "നിയന്ത്രിക്കുക"}
{"id": "ml242", "idiom": "ചർവിത ചവർണം", "meaning": "പറഞ്ഞത് തന്നെ വീണ്ടും ആവർത്തിക്കുക"}
{"id": "ml243", "idiom": "ചന്ദ്രഹാസമിളക്കുക", "meaning": "ഭീഷണി മുഴക്കി ഭയപ്പെടുത്തുക"}
{"id": "ml244", "idiom": "ചട്ടുകമാക്കുക", "meaning": "ഉപകരണമാക്കുക"}
{"id": "ml245", "idiom": "ചാക്കിട്ടു പിടുത്തം", "meaning": "സ്വാധീനത്തിൽ വരുത്തുക"}
{"id": "ml246", "idiom": "ചാണക്യ സൂത്രം", "meaning": "കൗശല വിദ്യ"}
{"id": "ml247", "idiom": "ചാട്ടത്തിൽ പിഴയ്ക്കുക", "meaning": "ഉന്നം തെറ്റുക"}
{"id": "ml248", "idiom": "ചുവപ്പുനാട", "meaning": "അനാവശ്യമായ കാലതാമസം"}
{"id": "ml249", "idiom": "ചിറ്റമ്മനയം", "meaning": "സ്നേഹം കുറഞ്ഞ പെരുമാറ്റം"}
{"id": "ml250", "idiom": "ചെണ്ട കൊട്ടിക്കുക", "meaning": "പരിഹാസ്യനാക്കുക"}
{"id": "ml251", "idiom": "ചെവി കടിക്കുക", "meaning": "തെറ്റിദ്ധരിപ്പിക്കുക"}
{"id": "ml252", "idiom": "ചെമ്പു തെളിയുക", "meaning": "കാപട്യം പുറത്തു വരിക"}
{"id": "ml253", "idiom": "ചൊല്ലിയാട്ടം", "meaning": "മുൻകൂട്ടിയുള്ള തയാറെടുപ്പ്"}
{"id": "ml254", "idiom": "തലയണമന്ത്രം", "meaning": "രഹസ്യമായ ദുർബോധനം"}
{"id": "ml255", "idiom": "തലമറന്നെണ്ണ തേയ്ക്കുക", "meaning": "അവസ്ഥയറിയാതെ പെരുമാറുക"}
{"id": "ml256", "idiom": "താപ്പാന", "meaning": "തഴക്കവും പഴക്കവും ഉള്ളയാൾ"}
{"id": "ml257", "idiom": "താളത്തിൽ ആകുക", "meaning": "പതുക്കെയാകുക"}
{"id": "ml258", "idiom": "താളത്തിനു തുള്ളുക", "meaning": "അന്യന്റെ ഹിതമനുസരിച്ചു പ്രവർത്തിക്കുക"}
{"id": "ml259", "idiom": "താളി പിഴിയുക", "meaning": "ദാസ്യവൃത്തി ചെയ്യുക"}
{"id": "ml260", "idiom": "തിരയെണ്ണുക", "meaning": "നിഷ്ഫലമായ പ്രവൃത്തി ചെയ്യുക"}
{"id": "ml261", "idiom": "തിണ്ണമിടുക്ക്", "meaning": "സ്വന്തം വീട്ടിൽ കാണിക്കുന്ന ശൗര്യം"}
{"id": "ml262", "idiom": "തീപ്പെടുക", "meaning": "മരിക്കുക"}
{"id": "ml263", "idiom": "തെക്കോട്ടു എടുക്കുക", "meaning": "മരിക്കുക"}
{"id": "ml264", "idiom": "തൊഴുത്തിൽ കുത്തു", "meaning": "വേണ്ടപ്പെട്ടവർ തമ്മിലുള്ള കലഹം"}
{"id": "ml265", "idiom": "തൃണവത്ഗണിക്കുക", "meaning": "നിസ്സാരമായി കാണുക"}
{"id": "ml266", "idiom": "ദന്തഗോപുരം", "meaning": "സാങ്കല്പിക സ്വർഗം"}
{"id": "ml267", "idiom": "ദരിദ്രനാരായണൻ", "meaning": "കടുത്ത ദാരിദ്ര്യം അനുഭവിക്കുന്നവൻ"}
{"id": "ml268", "idiom": "ദീപാളി കുളിക്കുക", "meaning": "അനാവശ്യ ചെലവു ചെയ്തു നശിപ്പിക്കൽ"}
{"id": "ml269", "idiom": "ദുര്യോധനന്റെ സ്വർഗ്ഗം", "meaning": "അല്പകാലം മാത്രം അനുഭവിച്ച ഭാഗ്യം"}
{"id": "ml270", "idiom": "ധനാശിപാടുക", "meaning": "അവസാനിപ്പിക്കുക"}
{"id": "ml271", "idiom": "ധൃതരാഷ്ട്രാലിഗനം", "meaning": "ഉള്ളിൽ പക വച്ചുകൊണ്ടുള്ള സ്നേഹപ്രകടനം"}
{"id": "ml272", "idiom": "നക്ഷത്രമെണ്ണുക", "meaning": "വളരെ ബുദ്ധിമുട്ടുക"}
{"id": "ml273", "idiom": "നക്രബാഷ്പം", "meaning": "കള്ളക്കണ്ണീർ"}
{"id": "ml274", "idiom": "മുതലക്കണ്ണീർ", "meaning": "കള്ളക്കണ്ണീർ"}
{"id": "ml275", "idiom": "നക്കി കൊല്ലുക", "meaning": "സ്നേഹിച്ചു ചതിക്കുക"}
{"id": "ml276", "idiom": "നഖശിഖാന്തം", "meaning": "അടിമുടി"}
{"id": "ml277", "idiom": "നടമാടുക", "meaning": "വ്യാപകമാകുക"}
{"id": "ml278", "idiom": "നട്ടം തിരിയുക", "meaning": "പ്രയാസം അനുഭവിക്കുക"}
{"id": "ml279", "idiom": "നാരദക്രിയ", "meaning": "ഏഷണി"}
{"id": "ml280", "idiom": "നാഥനില്ലാ കളരി", "meaning": "ഉത്തരവാദിത്തം ഏറ്റെടുക്കാൻ ആളില്ലാത്ത അവസ്ഥ"}
{"id": "ml281", "idiom": "നാട്ടുനടപ്പ്", "meaning": "ആചാരം"}
{"id": "ml282", "idiom": "നാന്ദി കുറിക്കുക", "meaning": "തുടക്കം കുറിക്കുക"}
{"id": "ml283", "idiom": "നിര്‍ഗുണ പരബ്രഹ്മം", "meaning": "പ്രയോജനശൂന്യമായ വസ്തു"}
{"id": "ml284", "idiom": "നീലക്കൊടുവേലി", "meaning": "അപൂർവ വസ്തു"}
{"id": "ml285", "idiom": "നെല്ലിപ്പടി കാണുക", "meaning": "അടിസ്ഥാനം വരെ കാണുക"}
{"id": "ml286", "idiom": "പത്താം നമ്പർ", "meaning": "വളരെ ഗുണം കുറഞ്ഞ"}
{"id": "ml287", "idiom": "പന്ത്രണ്ടാം മണിക്കൂർ", "meaning": "അവസാന നിമിഷം"}
{"id": "ml288", "idiom": "പതിനൊന്നാം മണിക്കൂർ", "meaning": "ഏതുകാര്യവും അവസാനനിമിഷം ചെയ്യുക"}
{"id": "ml289", "idiom": "പഞ്ചായത്ത് പറയുക", "meaning": "മധ്യസ്ഥം വഹിക്കുക"}
{"id": "ml290", "idiom": "പമ്പ കടക്കുക", "meaning": "തോറ്റോടുക"}
{"id": "ml291", "idiom": "പമ്പരം ചുറ്റിക്കുക", "meaning": "പരിഭ്രമിപ്പിച്ചു കഷ്ടപ്പെടുത്തുക"}
{"id": "ml292", "idiom": "പാഷാണത്തിൽ കൃമി", "meaning": "മഹാ ദുഷ്ടൻ"}
{"id": "ml293", "idiom": "പടി കടത്തുക", "meaning": "പുറത്താക്കുക"}
{"id": "ml294", "idiom": "പഠിച്ച് പണി പതിനെട്ടും നോക്കുക", "meaning": "കഴിവിന്‍റെ പരമാവധി ശ്രമിക്കുക"}
{"id": "ml295", "idiom": "പരുന്താടുക", "meaning": "ചുറ്റും കൂടിനിന്ന് അന്വേഷിക്കുക"}
{"id": "ml296", "idiom": "പള്ളയ്ക്കടിക്കുക", "meaning": "ഉപജീവന മാർഗ്ഗം തടയുക"}
{"id": "ml297", "idiom": "പള്ളിയറയിലെ കള്ളൻ", "meaning": "ഉന്നതസ്ഥാനങ്ങളിലെ കള്ളൻ"}
{"id": "ml298", "idiom": "പാതിരി മലയാളം", "meaning": "വികലമായ ഭാഷ"}
{"id": "ml299", "idiom": "പാലും തേനും ഒഴുകുക", "meaning": "ഐശ്വര്യസമ്യദ്ധമായിരിക്കുക"}
{"id": "ml300", "idiom": "പാമ്പിനു പാലു കൊടുക്കുക", "meaning": "ദുഷ്ടന്‍മാരെ സഹായിക്കുക"}
{"id": "ml301", "idiom": "പാലം വലിക്കൽ", "meaning": "ചതിപ്രയോഗം"}
{"id": "ml302", "idiom": "പിഴമൂളുക", "meaning": "തെറ്റ് സമ്മതിക്കുക"}
{"id": "ml303", "idiom": "പുസ്തകപ്പുഴു", "meaning": "പ്രായോഗികജ്ഞാനം ഇല്ലാത്തവൻ"}
{"id": "ml304", "idiom": "പുത്തരിയില്‍ കല്ല്‌", "meaning": "ആരംഭത്തില്‍ത്തന്നെ അമംഗളം"}
{"id": "ml305", "idiom": "പുലിവാല് പിടിക്കുക", "meaning": "തന്നത്താന്‍ കുഴപ്പത്തില്‍ ചാടുക"}
{"id": "ml306", "idiom": "പൂച്ചു തെളിയുക", "meaning": "വാസ്തവം വെളിപ്പെടുക"}
{"id": "ml307", "idiom": "പൊടിയിട്ട് വിളക്കുക", "meaning": "ക്യത്രിമ ശോഭ ഉണ്ടാക്കുക"}
{"id": "ml308", "idiom": "ഭീഷ്മ പ്രതിജ്ഞ", "meaning": "മാറ്റമില്ലാത്ത ഉറച്ച തീരുമാനം"}
{"id": "ml309", "idiom": "ഭരതവാക്യം", "meaning": "അവസാനവാക്ക്"}
{"id": "ml310", "idiom": "ഭഗീരഥപ്രയത്നം", "meaning": "കഠിനപരിശ്രമം"}
{"id": "ml311", "idiom": "ഭൈമീകാമുകൻമാർ", "meaning": "സ്ഥാനമോഹികൾ"}
{"id": "ml312", "idiom": "മര്‍ക്കടമുഷ്ടി", "meaning": "ദുഃശാഠ്യം"}
{"id": "ml313", "idiom": "മണ്ണാന്റെ കഴുത", "meaning": "സ്വൈരം കെട്ട ജീവിതം"}
{"id": "ml314", "idiom": "മഞ്ഞൾ പറിക്കുക", "meaning": "നാണിച്ചു പോകുക"}
{"id": "ml315", "idiom": "മുഖത്ത് കരി തേക്കുക", "meaning": "നാണക്കേടുണ്ടാക്കുക"}
{"id": "ml316", "idiom": "മുടന്തൻ ന്യായം", "meaning": "കഴമ്പില്ലാത്ത വാദഗതി"}
{"id": "ml317", "idiom": "മുട്ടയിട്ട കോഴിക്ക് എരിവറിയാം", "meaning": "അനുഭവിച്ചവർക്ക് ബുദ്ധിമുട്ട് മനസിലാകും"}
{"id": "ml318", "idiom": "മുട്ടുശാന്തി", "meaning": "താല്‍ക്കാലികമായ ഏര്‍പ്പാട്"}
{"id": "ml319", "idiom": "മുയൽ കൊമ്പ്", "meaning": "ഇല്ലാത്ത വസ്തു"}
{"id": "ml320", "idiom": "മൂക്കിൽ കയറിടുക", "meaning": "നിയന്ത്രിക്കുക"}
{"id": "ml321", "idiom": "രസച്ചരട് പൊട്ടുക", "meaning": "ഇടയ്ക്ക് നീരസം ഉണ്ടാവുക"}
{"id": "ml322", "idiom": "രാമേശ്വരത്തെ ക്ഷൗരം", "meaning": "ഒരു കാര്യം പൂർത്തിയാക്കാത്ത അവസ്ഥ"}
{"id": "ml323", "idiom": "ലഗ്നാലും ചന്ദ്രാലും", "meaning": "ഏതു വിധത്തിലും"}
{"id": "ml324", "idiom": "വനരോദനം", "meaning": "നിഷ്പ്രയോജനമായ സങ്കടം പറച്ചിൽ"}
{"id": "ml325", "idiom": "വളംവച്ചു കൊടുക്കുക", "meaning": "പ്രോത്സാഹിപ്പിക്കുക"}
{"id": "ml326", "idiom": "വയറ്റത്തടിക്കുക", "meaning": "ഉപജീവന മാർഗം തടയാൻ നോക്കുക"}
{"id": "ml327", "idiom": "വഞ്ചി ഇപ്പോഴും തിരുനക്കരത്തന്നെ", "meaning": "പുരോഗതി ഇല്ലായ്മ"}
{"id": "ml328", "idiom": "വിലങ്ങുതടി", "meaning": "തടസ്സം"}
{"id": "ml329", "idiom": "വിഷകന്യക", "meaning": "നാശകാരിണി"}
{"id": "ml330", "idiom": "വ്യാഴദശ", "meaning": "ഭാഗ്യകാലം"}
{"id": "ml331", "idiom": "വെടിവട്ടം", "meaning": "നേരംപോക്ക്"}
{"id": "ml332", "idiom": "വെള്ളത്തില്‍ എഴുതുക", "meaning": "വ്യര്‍ഥ്മായ പ്രവ്യത്തി"}
{"id": "ml333", "idiom": "വെള്ളത്തില്‍ വരച്ച വര", "meaning": "വ്യർത്ഥമായ പ്രവ്യത്തി"}
{"id": "ml334", "idiom": "വെള്ളിയാഴ്ചക്കറ്റം", "meaning": "ദുര്‍ബലമായ തടസ്സവാദം"}
{"id": "ml335", "idiom": "വേലിതന്നെ വിളവ് തിന്നുക", "meaning": "സ്വപക്ഷത്തിനു ദോഷം വരുത്തുക"}
{"id": "ml336", "idiom": "വേദവാക്യം", "meaning": "ലംഘിക്കാനാവാത്ത അഭിപ്രായം"}
{"id": "ml337", "idiom": "വൈതരണി", "meaning": "ദുര്‍ഘടം"}
{"id": "ml338", "idiom": "ശുക്രദശ", "meaning": "നല്ലകാലം"}
{"id": "ml339", "idiom": "ശതകം ചൊല്ലിക്കുക", "meaning": "വിഷമിപ്പിക്കുക"}
{"id": "ml340", "idiom": "ശവത്തില്‍ കുത്തുക", "meaning": "അവശനെ ഉപദ്രവിക്കുക"}
{"id": "ml341", "idiom": "ശിങ്കിടി പാടുക", "meaning": "ഏറ്റുപാടുക"}
{"id": "ml342", "idiom": "ശ്ലോകത്തിൽ കഴിക്കുക", "meaning": "വളരെ ചുരുക്കി പറയുക"}
{"id": "ml343", "idiom": "സർപ്പന്യായം", "meaning": "അന്യരുടെ അധ്വാനത്തിന്റെ ഫലം തട്ടിയെടുത്തു ജീവിക്കുക"}
{"id": "ml344", "idiom": "സിംഹാവലോകനം", "meaning": "ആകെ കൂടി നോക്കുക"}
{"id": "ml345", "idiom": "സുഗ്രീവാജ്ഞ", "meaning": "അലംഘനീയമായ കല്പന"}
{"id": "ml346", "idiom": "സുഗ്രീവശാസന", "meaning": "അലംഘനീയമായ കല്പന"}
{"id": "ml347", "idiom": "സ്ഥലജലഭ്രമം", "meaning": "ആശയക്കുഴപ്പം"}
{"id": "ml348", "idiom": "സ്വർഗ്ഗത്തിലെ കട്ടുറുമ്പ്", "meaning": "സമാധാനപരമായ ഒരന്തരീക്ഷത്തിന്റെ സന്തോഷം നശിപ്പിക്കുന്നവൻ"}
{"id": "ml349", "idiom": "അങ്ങാടിപ്പാട്ട", "meaning": "പരസ്യം"}
{"id": "ml350", "idiom": "അര്‍തഥ്രാത്രിയില്‍ കുടപിടിക്കുക", "meaning": "അസ്ഥനത്തുള്ള ആഡംബരം"}
{"id": "ml351", "idiom": "അലസിപ്പിരിയുക", "meaning": "തിരുമാനം ഇല്ലാതെ പിരിയുക"}
{"id": "ml352", "idiom": "അറുത്തകൈക്ക് ഉപ്പ് തെക്കാതിരിക്കുക", "meaning": "നിര്‍ദ്ദയനായിരിക്കുക"}
{"id": "ml353", "idiom": "ഇടപഴകുക", "meaning": "പരിചയിക്കുക"}
{"id": "ml354", "idiom": "ഉര്‍വശിശാപം ഉപകാരം", "meaning": "ദോഷം ഗുണമായിത്തിരുക"}
{"id": "ml355", "idiom": "ആനമുട്ട", "meaning": "ഇല്ലാത്തവസ്തു"}
{"id": "ml356", "idiom": "കൈ കഴുകുക", "meaning": "ഉപേക്ഷിച്ച് രക്ഷപെടുക"}
{"id": "ml357", "idiom": "കോടാലി", "meaning": "ഉപദ്രവകാരി"}
{"id": "ml358", "idiom": "ഗ്രന്ഥകീടം", "meaning": "പുസ്തകപ്പുഴു"}
{"id": "ml359", "idiom": "ജലരേഖ", "meaning": "വെള്ളത്തിൽ വരച്ച വരപോലെ പാഴിലായത്"}
{"id": "ml360", "idiom": "തട്ടിവിടുക", "meaning": "കൂസലില്ലതെ ഓരോന്ന് പറയുക"}
{"id": "ml361", "idiom": "തേച്ചു മായ്ച്ചു കളയുക", "meaning": "തെളിവും മറ്റും നശിപ്പിക്കുക"}
{"id": "ml362", "idiom": "തോളിലിരുന്നു ചെവി തിന്നുക", "meaning": "അടുത്തുക്കുടി ചതിക്കുക"}
{"id": "ml363", "idiom": "നട്ടെല്ല്", "meaning": "പൌരുഷം, ധൈര്യം, തന്റേടം"}
{"id": "ml364", "idiom": "നാരദൻ", "meaning": "ഏഷണിക്കാരൻ"}
{"id": "ml365", "idiom": "പകിട", "meaning": "കൗശല പ്രയോഗം"}
{"id": "ml366", "idiom": "പഴയ മണ്ണ്‍", "meaning": "യാതൊന്നും ഉണ്ടാവാത്തത്"}
{"id": "ml367", "idiom": "പിടലിയൊടിയുക", "meaning": "വിഷമം നേരിടുക"}
{"id": "ml368", "idiom": "പിത്തലാട്ടം", "meaning": "നാട്യം, ഭാവം"}
{"id": "ml369", "idiom": "പുത്തനച്ചി", "meaning": "ഒരു കാര്യം ചെയ്യാൻ തുടങ്ങുമ്പോഴുള്ള ഉത്സാഹക്കുടുതൽ"}
{"id": "ml370", "idiom": "ആറിയ കഞ്ഞി പഴങ്കഞ്ഞി", "meaning": "തുടക്കത്തിൽ പറയുമ്പോൾ ഉള്ള ഉത്സാഹം പിന്നെയില്ലാതാവുക"}
{"id": "ml371", "idiom": "ഉണ്ണാതെ തിന്നാതെ", "meaning": "ഒന്നും അനുഭവിക്കാതെ"}
{"id": "ml372", "idiom": "ഉരുക്കഴിക്കുക", "meaning": "ആവർത്തിക്കുക"}
{"id": "ml373", "idiom": "കമ്പോടുകമ്പ്", "meaning": "ആദ്യാവസാനം"}
{"id": "ml374", "idiom": "കിളികിളി പോലെ പറയുക", "meaning": "തടസ്സം കൂടാതെ പറയുക"}
{"id": "ml375", "idiom": "കുത്തിപ്പൊക്കുക", "meaning": "മറന്ന സംഭവം വീണ്ടും ശ്രദ്ധയിൽ കൊണ്ടുവരിക"}
{"id": "ml376", "idiom": "കുന്തം വിഴുങ്ങിയ പോലെ", "meaning": "അമ്പരന്ന് നിൽക്കുക"}
{"id": "ml377", "idiom": "അവത പറയുക", "meaning": "സങ്കടം പറയുക"}
{"id": "ml378", "idiom": "അഷ്ട ദാരിദ്ര്യം", "meaning": "അതിയായ കഷ്ടപ്പാട്"}
{"id": "ml379", "idiom": "അകപ്പാട് പറ്റുക", "meaning": "ആപത്തുണ്ടാക്കുക"}
{"id": "ml380", "idiom": "മുളയിലേ നുള്ളുക", "meaning": "ഒരു കാര്യം വളരാനോ വലുതാകാനോ അനുവദിക്കാതെ തുടക്കത്തിൽ തന്നെ ഇല്ലാതാക്കുക"}
